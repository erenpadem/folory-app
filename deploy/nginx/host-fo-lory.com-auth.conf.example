# fo-lory.com — şifre korumalı beta (EN KOLAY yol, ayrı subdomain gerekmez)
# Mevcut prod stack (8082) aynen çalışır; sadece dışarıdan erişim şifreli olur.
#
# Kurulum:
#   apt install apache2-utils
#   htpasswd -c /etc/nginx/.htpasswd-folory betauser
#   cp deploy/nginx/host-fo-lory.com-auth.conf.example /etc/nginx/sites-enabled/folory.conf
#   nginx -t && systemctl reload nginx
#
# Şifreyi yazarlarla paylaş. Prod stack değişmez.

server {
    listen 443 ssl http2;
    server_name fo-lory.com www.fo-lory.com;

    ssl_certificate     /etc/ssl/folory/fo-lory_com.pem;
    ssl_certificate_key /etc/ssl/folory/fo-lory_com.key;

    auth_basic "Fo-lory Beta — davetliler";
    auth_basic_user_file /etc/nginx/.htpasswd-folory;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name fo-lory.com www.fo-lory.com;
    return 301 https://$host$request_uri;
}
