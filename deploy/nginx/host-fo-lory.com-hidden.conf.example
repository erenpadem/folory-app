# fo-lory.com'u geçici gizle — "Yakında" sayfası
# Kullanım (sunucuda):
#   cp /etc/nginx/sites-enabled/folory.conf /etc/nginx/sites-enabled/folory.conf.public.bak
#   cp deploy/nginx/host-fo-lory.com-hidden.conf.example /etc/nginx/sites-enabled/folory.conf
#   nginx -t && systemctl reload nginx
#
# Geri aç:
#   cp /etc/nginx/sites-enabled/folory.conf.public.bak /etc/nginx/sites-enabled/folory.conf
#   nginx -t && systemctl reload nginx

server {
    listen 443 ssl http2;
    server_name fo-lory.com www.fo-lory.com;

    ssl_certificate     /etc/ssl/folory/fo-lory_com.pem;
    ssl_certificate_key /etc/ssl/folory/fo-lory_com.key;

    root /var/www/folory-maintenance;
    index index.html;

    location / {
        try_files $uri /index.html;
    }
}

server {
    listen 80;
    server_name fo-lory.com www.fo-lory.com;
    return 301 https://fo-lory.com$request_uri;
}
