# =============================================================================
# Fo-lory production — deploy/.env
# Sunucu: 178.104.191.166  |  Domain: fo-lory.com
# Copy to .env on the server. Never commit secrets.
# =============================================================================

# --- GHCR (build GitHub Actions'ta; sunucu sadece pull eder) ---
REGISTRY=ghcr.io
# Org yok — kişisel repo: github.com/erenpadem/folory-app
IMAGE_NAME=erenpadem/folory-app
GHCR_USERNAME=erenpadem
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Aktif slot imaj etiketleri (deploy script günceller)
BLUE_TAG=latest
GREEN_TAG=latest
WORKER_TAG=latest

# --- Uygulama ---
# APP_NAME = marka adı (UI'da "Fo-lory" görünür; domain: fo-lory.com)
APP_NAME=Fo-lory
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_URL=https://fo-lory.com
FRONTEND_URL=https://fo-lory.com

# Frontend build-time (GitHub Actions Variables ile aynı olmalı)
NEXT_PUBLIC_API_URL=https://fo-lory.com
NEXT_PUBLIC_SITE_URL=https://fo-lory.com

# Sanctum / session — tek domain reverse proxy
SANCTUM_STATEFUL_DOMAINS=fo-lory.com,www.fo-lory.com
SESSION_DOMAIN=.fo-lory.com
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Veritabanı (paylaşımlı — blue/green aynı DB) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=folory
DB_USERNAME=folory
DB_PASSWORD=change-me-strong-password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- OAuth (Google/Apple console'da callback: https://fo-lory.com/api/auth/...) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@fo-lory.com
MAIL_FROM_NAME=Fo-lory

# --- AWS S3 (önerilir — storage paylaşımı için) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=

# --- Edge nginx ---
# Fo-lory dışarıya SADECE bu portu açar. Diğer servisler (postgres, redis, api, frontend)
# host'a port bind etmez — Docker iç ağında kalır.
#
# Sunucuda kullanımda olan portlar (DOKUNMA):
#   3000, 3001, 3010, 4000, 4010, 5432, 6379, 7880-7881, 7882, 9010-9011,
#   1025, 8025, 50000-50500 (mentora, docker-*, livekit, minio, mailpit)
HTTP_BIND=127.0.0.1
HTTP_PORT=8082

# Deploy davranışı
DRAIN_SOAK_SECONDS=30
HEALTH_CHECK_ATTEMPTS=30
HEALTH_CHECK_INTERVAL=5

# DNS henüz yoksa geçici test (SSL öncesi):
# APP_URL=http://178.104.191.166
# FRONTEND_URL=http://178.104.191.166
# NEXT_PUBLIC_API_URL=http://178.104.191.166
# NEXT_PUBLIC_SITE_URL=http://178.104.191.166
