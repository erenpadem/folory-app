# Fo-lory BETA — deploy/.env.beta (prod .env'den AYRI kopyala)
# cp .env.beta.example .env.beta && düzenle

REGISTRY=ghcr.io
IMAGE_NAME=erenpadem/folory-app
GHCR_USERNAME=erenpadem
GHCR_TOKEN=

BETA_TAG=latest

APP_NAME="Fo-lory Beta"
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_URL=https://beta.fo-lory.com
FRONTEND_URL=https://beta.fo-lory.com

# Frontend CI build bu URL'lerle yapılmalı (beta imajı veya latest + aynı origin)
NEXT_PUBLIC_API_URL=https://beta.fo-lory.com
NEXT_PUBLIC_SITE_URL=https://beta.fo-lory.com

SANCTUM_STATEFUL_DOMAINS=beta.fo-lory.com
SESSION_DOMAIN=.fo-lory.com
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=folory_beta
DB_USERNAME=folory
DB_PASSWORD=change-me-strong-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

HTTP_BIND=127.0.0.1
HTTP_PORT=8083

MAIL_FROM_ADDRESS=noreply@fo-lory.com
MAIL_FROM_NAME="Fo-lory Beta"
