APP_NAME=Folory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# OAuth2 (Google / Apple) — Socialite stateless; callback: {APP_URL}/api/auth/{provider}/callback
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
#
# Apple: Developer → Identifiers → Services ID (client_id) + Keys → Sign in with Apple (.p8 indir, bir kez)
# APPLE_CLIENT_SECRET boş bırakılabilir; paket private_key ile JWT üretir (6 ay geçerli, istek başına yenilenir)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/api/auth/apple/callback"
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Mutlak yol: /var/www/AuthKey_XXXXX.p8 veya Docker içinde mount edilen yol
APPLE_PRIVATE_KEY=
# Eski isim (geriye dönük); yoksa APPLE_PRIVATE_KEY kullanılır
APPLE_KEY_FILE_PATH=
# APPLE_PASSPHRASE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = geliştirme; production için smtp, postmark veya resend
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# E-posta şablonları (MJML) için Docker imajında Node 20 gerekir — backend Dockerfile'a eklenmiştir; imajı yeniden oluşturun.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
